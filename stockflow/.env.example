# Copy to .env.local for local development:
#   cp .env.example .env.local

# API gateway (auth + market proxy)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Real-time stock prices via websocket-service (port 8083)
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8083

# Sentry — quantflow/quantflow project
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=quantflow
SENTRY_PROJECT=quantflow
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_AUTH_TOKEN=

# PostHog — Project Settings → Project API Key (phc_...)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side PostHog (optional — falls back to NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Finnhub — server-side only (quotes/candles Next.js API routes, proxied via gateway)
FINNHUB_API_KEY=
