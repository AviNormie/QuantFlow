# Copy to .env.local for local development:
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Production (Render / Vercel) — set in hosting dashboard, NOT in git
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://stockflow-api-gateway.onrender.com
# NEXT_PUBLIC_WEBSOCKET_URL=https://stockflow-websocket.onrender.com
# (https URLs are auto-converted to wss:// for WebSocket connections)

# Local defaults
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8083

# Sentry — quantflow/quantflow project
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=quantflow
SENTRY_PROJECT=quantflow
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_AUTH_TOKEN=

# PostHog — Project Settings → Project API Key (phc_...)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side PostHog (optional — falls back to NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
