{
  "openapi": "3.1.0",
  "info": {
    "title": "StockFlow API",
    "version": "0.1.0",
    "description": "StockFlow inventory and operations API."
  },
  "servers": [
    {
      "url": "/api",
      "description": "Local API"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Returns API availability status.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
