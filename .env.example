# Copy to .env and adjust for local development:
#   cp .env.example .env

# PostgreSQL
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow
POSTGRES_DB=stockflow
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Go microservices (host ports when using docker compose)
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8084
MARKET_SERVICE_PORT=8082
WEBSOCKET_SERVICE_PORT=8083

# Connection strings (for apps on your host machine)
DATABASE_URL=postgres://stockflow:stockflow@localhost:5432/stockflow?sslmode=disable
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Sentry — Go microservices (quantflow org)
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=stockflow@local
SENTRY_TRACES_SAMPLE_RATE=0.2

# ---------------------------------------------------------------------------
# Sentry — Next.js frontend (stockflow/)
# See stockflow/.env.example for full Next.js Sentry vars.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=quantflow
SENTRY_PROJECT=quantflow
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# PostHog — Go microservices
# Project Settings → Project API Key (phc_...)
# ---------------------------------------------------------------------------
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# PostHog — Next.js frontend (stockflow/.env.local)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Auth — JWT signing secret (auth-service + api-gateway CORS)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# Finnhub — market data (websocket-service only)
# https://finnhub.io/register
# ---------------------------------------------------------------------------
FINNHUB_API_KEY=
