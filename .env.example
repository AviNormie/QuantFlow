# Copy to .env and adjust for local development:
#   cp .env.example .env

# PostgreSQL
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow
POSTGRES_DB=stockflow
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Go microservices (host ports when using docker compose)
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8084
MARKET_SERVICE_PORT=8082
WEBSOCKET_SERVICE_PORT=8083

# Connection strings (for apps on your host machine)
DATABASE_URL=postgres://stockflow:stockflow@localhost:5432/stockflow?sslmode=disable
REDIS_URL=redis://localhost:6379

# Inside Docker Compose (set automatically for backend containers)
# DATABASE_URL=postgres://stockflow:stockflow@postgres:5432/stockflow?sslmode=disable
# REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Monitoring (Sentry + PostHog) — shared by all Go services
# Leave blank to disable that integration locally.
# ---------------------------------------------------------------------------

# Sentry — https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=stockflow@local
SENTRY_TRACES_SAMPLE_RATE=0.2

# PostHog — https://posthog.com → Project Settings → Project API Key
POSTHOG_API_KEY=
# US cloud: https://us.i.posthog.com | EU cloud: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
