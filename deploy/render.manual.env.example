# Copy to deploy/render.manual.env (never commit) and fill in values.
# Used by: ./scripts/render-sync-env.sh

# Required — market data ingestion
FINNHUB_API_KEY=

# Required — CORS for your Vercel frontend (comma-separated, no trailing slashes)
# Example: https://quantflow.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Optional — monitoring for Go services (api-gateway, auth, market, websocket)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=stockflow@production
SENTRY_TRACES_SAMPLE_RATE=0.2
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
